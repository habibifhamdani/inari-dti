APP_NAME="INARI DTI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.inari-dti.example.com
FRONTEND_URL=https://inari-dti.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL (Railway injects DATABASE_URL or PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD)
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inari_dti
DB_USERNAME=postgres
DB_PASSWORD=

# CORS & Sanctum
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://inari-dti.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=
SANCTUM_STATEFUL_DOMAINS=localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# Cloudflare R2 (S3-compatible object storage — required on Railway ephemeral filesystem)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=inari-dti-media
AWS_URL=https://cdn.inari-dti.example.com
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Transactional Email over HTTP API (Resend — avoid SMTP ports 25/465/587 on Railway Hobby)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@inari-dti.example.com"
MAIL_FROM_NAME="${APP_NAME}"
